# ---------------------------------------------------------------------------
# آوید — نمونه‌ی متغیرهای محیطی (این فایل را به .env کپی و مقدارها را
# متناسب VPS خود تغییر دهید):
#     cp .env.example .env
# فایل .env واقعی هرگز در خروجی/گیت قرار نمی‌گیرد.
# ---------------------------------------------------------------------------

# — پورت‌های میزبان (فقط روی 127.0.0.1؛ پروکسی دامنه در جلو است) —
# وب روی 127.0.0.1:3900 → 3000 (کانتینر) و /socket.io/ روی 127.0.0.1:3004
WEB_PORT=3900
CHAT_PORT=3004

# — منطقه‌ی زمانی —
TZ=Asia/Tehran

# — مبدای رسمی سایت (توصیه‌شده) — روی سرور اصلی آوید: SITE_URL=https://amlm.ir
# مثال عمومی: SITE_URL=https://academy.example.com
# وقتی تنظیم شود آدرس بازگشت درگاه پرداخت (callback) از همین مقدار ساخته
# می‌شود و دیگر به هدرهای درخواست (Host/X-Forwarded-Host — قابل جعل) متکی
# نیست. خالی = هدرهای پروکسی (رفتار پیشین؛ مناسب وقتی چند دامنه به یک
# سایت اشاره می‌کنند).
SITE_URL=

# — مبداهای اضافه‌ی مجاز (اختیاری) —
# CSRF و اتصال سوکت فقط از SITE_URL و «هم‌مبدأ» پذیرفته می‌شوند؛ اگر
# دامنه/زیردامنه‌ی دیگری هم مجاز است (مثلاً پنل مدیریت روی دامنه‌ی جدا)
# اینجا ویرگول‌جداشده بیاورید: https://panel.example.com
ALLOWED_ORIGINS=

# — امضای لینک‌های خصوصی گواهینامه (اختیاری) —
# لینک‌های دانلود گواهینامه با HMAC امضا می‌شوند؛ پیش‌فرض از
# CHAT_AUTH_SECRET استفاده می‌شود — مقدار جدا لازم نیست مگر بخواهید
# چرخش رمز مستقل داشته باشید (openssl rand -hex 32).
FILE_SIGN_SECRET=

# — حساب مدیر —
# فقط هنگام نخستین راه‌اندازی (دیتابیس خالی) به‌کار می‌رود؛ حساب‌های
# موجود هرگز تغییری نمی‌گیرند.
# امنیت: اگر ADMIN_INITIAL_PASSWORD خالی/کوتاه باشد، رمز «تصادفی» ساخته
# و فقط یک بار در لاگ سرویس migrate (docker compose logs migrate) چاپ
# می‌شود — رمز پیش‌فرض ثابتی مثل admin123 دیگر ساخته نمی‌شود.
# ADMIN_FORCE_RESET=1 → رمز مدیر همین مقدار می‌شود و همه‌ی نشست‌ها باطل
# می‌شوند (بازیابی دسترسی؛ فقط برای موارد اضطراری).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_FORCE_RESET=0

# — رمز امضای تیکت‌های عضویت چت — (الزامی)
# یک مقدار تصادفی تولید کنید و همان را نگه دارید:
#   openssl rand -hex 32
# بدون این مقدار، docker compose با پیام خطا متوقف می‌شود (کلید ثابتی
# در کد وجود ندارد) و سرویس چت هم در production بدون آن اجرا نمی‌شود.
CHAT_AUTH_SECRET=

# — نمایش کد تایید در پاسخ API وقتی پنل پیامکی واقعی پیکربندی نشده —
# فقط محیط توسعه؛ در production این کد هرگز در پاسخ API برگردانده نمی‌شود
# (حتی با مقدار ۱). پس از پیکربندی ملی‌پیامک روی VPS، ورود/ثبت‌نام با
# پیامک واقعی انجام می‌شود.
OTP_DEV_CODE=0

# — نگهداری بکاپ‌ها (اختیاری؛ پیش‌فرض ۱۴) —
# BACKUP_KEEP=14
