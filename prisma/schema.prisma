generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// هویت و تنظیمات کلی سایت (رکورد یگانه با id = "main")
model SiteSettings {
  id                    String   @id @default("main")
  siteName              String   @default("آوید")
  tagline               String   @default("آکادمی مهارت‌های آینده")
  slogan                String   @default("یادگیری هر مهارتی، سرمایه‌ی شما در آینده است")
  heroDescription       String   @default("در آکادمی آوید، از هوش مصنوعی تا برنامه‌نویسی کودکان، با پروژه‌های واقعی و پشتیبانی متخصص‌ها مهارت بسازید و آینده شغلی خود را تضمین کنید.")
  logoUrl               String   @default("/images/logo.png")
  // — favicon اختصاصی (آیکون تب مرورگر) — خالی یعنی همان لوگوی سایت استفاده می‌شود
  faviconUrl            String   @default("")
  studentsCount         Int      @default(270)
  completedCoursesCount Int      @default(13)
  rating                Float    @default(4.9)
  // — اطلاعات تماس: پیش‌فرض خالی — داده‌ی نمونه‌ی ساختگی در نصب تازه تزریق
  // نمی‌شود؛ مدیر از ماژول «تنظیمات سایت» مقادیر واقعی را وارد می‌کند.
  contactPhone          String   @default("")
  contactEmail          String   @default("")
  address               String   @default("")
  supportHours          String   @default("")
  instagramUrl          String   @default("")
  telegramUrl           String   @default("")
  youtubeUrl            String   @default("")
  linkedinUrl           String   @default("")
  footerDescription     String   @default("یادگیری هر مهارتی، سرمایه‌ی شما در آینده است. ما با دوره‌های پروژه‌محور و مربیان متخصص، همراه شما در این مسیر هستیم.")
  // — کد نماد اعتماد الکترونیکی (اینماد): عیناً از پنل enamad.ir دریافت و بدون تغییر در فوتر سایت رندر می‌شود —
  enamadCode            String   @default("")
  // — کد نماد اعتماد زرین‌پال (لوگو تایید درگاه پرداخت، طبق مستندات رسمی زرین‌پال) — در فوتر، سمت راست اینماد رندر می‌شود —
  zarinpalCode          String   @default("")
  // — فونت‌های قابل انتخاب از ماژول «فونت‌ها» (کلیدهای رجیستری src/lib/fonts.ts) —
  sloganFont            String   @default("vazirmatn") // فونت اسلوگان اصلی صفحه‌ی خانه
  headerFont            String   @default("vazirmatn") // فونت هدر (نوار بالا)
  footerFont            String   @default("vazirmatn") // فونت فوتر (پاورقی)
  // — ویرایشگر ظاهری مدادی — وقتی فعال باشد، مدیر هنگام مشاهده‌ی سایت
  // کنار متن‌های کلیدی صفحه‌ی اول آیکون مداد می‌بیند و می‌تواند متن، رنگ،
  // فونت، اندازه و نمایش/مخفی‌بودن هر متن را در پاپ‌آپ ویرایش کند.
  pencilEditorEnabled   Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// ————————————————— ویرایشگر مدادی متن‌ها —————————————————

// متن‌های قابل‌ویرایش صفحه‌ی اول سایت (ویرایشگر ظاهری مدادی) —
// هر جایگاه متن با یک کلید یکتا (مثل hero.slogan) شناسایی می‌شود.
// مقدارهای null یعنی «پیش‌فرض قطعه‌ی سایت» (بدون سفارشی‌سازی).
// برای دو متن هیرو (hero.slogan و hero.description) متن به‌صورت آینه در
// SiteSettings (slogan و heroDescription) هم نگه داشته می‌شود تا با ماژول
// «تنظیمات سایت» پنل مدیر کاملاً هماهنگ بماند؛ فونت اسلوگان نیز با
// SiteSettings.sloganFont همگام است.
model SiteText {
  key       String   @id // کلید یکتای جایگاه متن — رجیستری src/lib/site-texts.ts
  text      String? // متن سفارشی؛ خالی/null = متن پیش‌فرض قطعه
  color     String? // رنگ متن (هگز مثل #0d9488)؛ null = رنگ پیش‌فرض قالب
  fontKey   String? // کلید فونت از رجیستری InstalledFont؛ null = فونت پیش‌فرض قطعه
  fontSize  Int? // اندازه فونت دسکتاپ (پیکسل)؛ null = اندازه‌ی پیش‌فرض قطعه
  hidden    Boolean  @default(false) // مخفی برای کاربران عادی در همه‌ی دستگاه‌ها (مدیر همچنان می‌بیند)

  // — واکنش‌گرایی به تفکیک دستگاه (ویرایشگر مدادی) —
  // اندازه‌ی تبلت/موبایل: null = همان اندازه‌ی دسکتاپ (fontSize)
  fontSizeTablet Int? // اندازه فونت تبلت (۷۶۸ تا ۱۰۲۳ پیکسل عرض)
  fontSizeMobile Int? // اندازه فونت موبایل (زیر ۷۶۸ پیکسل عرض)

  // مخفی‌سازی مجزا در هر دستگاه: فقط برای کاربران عادیِ همان دستگاه (مدیر همیشه می‌بیند)
  hiddenDesktop Boolean @default(false) // مخفی در دسکتاپ (عرض ≥۱۰۲۴)
  hiddenTablet  Boolean @default(false) // مخفی در تبلت (۷۶۸–۱۰۲۳)
  hiddenMobile  Boolean @default(false) // مخفی در موبایل (زیر ۷۶۸)
  updatedAt DateTime @updatedAt
}

// دوره‌های آموزشی — سه نوع: آنلاین، حضوری و ترکیبی (حضوری و آنلاین)
model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   @default("عمومی")
  type        String   @default("online") // online | inperson | hybrid (آنلاین | حضوری | حضوری و آنلاین)
  level       String   @default("مقدماتی") // مقدماتی | متوسط | پیشرفته
  hours       Int      @default(0)
  sessions    Int      @default(0)
  instructor  String   @default("")
  price       Int      @default(0) // تومان؛ صفر یعنی رایگان
  cashTuition        Int      @default(10000000) // شهریه نقدی این دوره (تومان)
  installmentTuition Int      @default(12000000) // مبلغ کل اقساطی این دوره (تومان)؛ صفر = بدون گزینه اقساطی
  capacity    Int      @default(0) // ظرفیت دوره (نفر)؛ صفر = بدون محدودیت — آنلاین معمولاً ۲۰؛ حضوری = مجموع ظرفیت گروه‌ها
  schedule    String   @default("") // زمان‌بندی (مخصوص دوره‌های حضوری)
  students    Int      @default(0)
  icon        String   @default("Sparkles") // نام آیکون از رجیستری
  imageUrl    String   @default("") // تصویر شاخص/بندانگشتی دوره (آپلود یا آدرس)؛ خالی = نمایش آیکون
  theme       String   @default("teal") // کلید تم از رجیستری
  tag         String? // برچسب ویژه مثل «پرمخاطب»
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // گروه‌های زمان‌بندی بخش حضوری دوره‌های حضوری/ترکیبی — هر گروه زمان‌بندی و ظرفیت جداگانه دارد
  groups      CourseGroup[]

  // — قالب اقساط دوره — تعداد و تاریخ سررسید هر قسط (اختیاری؛
  // خالی = تعداد از تنظیمات سراسری و سررسید ۳۰ روزه خودکار)
  installmentTemplate CourseInstallment[]

  // جلسات حضور و غیاب دوره — یک ردیف برای هر جلسه‌ی فعال‌شده/برگزارشده
  attendanceSessions AttendanceSession[]

  // آزمون‌های وابسته به این دوره
  exams       Exam[]

  // گواهینامه‌های صادرشده برای این دوره
  certificates Certificate[]

  // دعوت‌های کلاس‌های آنلاین (استریم) این دوره
  streamInvitations StreamInvitation[]

  // — استاد مالک دوره (اختیاری) — دوره‌هایی که استاد از پنل خود ساخته است؛
  // null یعنی دوره‌ی مدیر. حذف استاد، دوره‌ها را نگه می‌دارد (SetNull).
  teacher   User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?

  @@index([teacherId])
}

// گروه‌های زمان‌بندی بخش حضوری دوره‌های حضوری/ترکیبی —
// هر گروه (مثلاً دوشنبه/چهارشنبه یا یکشنبه/سه‌شنبه) ظرفیت جداگانه‌ای دارد
model CourseGroup {
  id         String   @id @default(cuid())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  title      String // مثلاً «گروه ۱»
  schedule   String   @default("") // مثلاً «دوشنبه و چهارشنبه، ۱۶ تا ۱۸»
  capacity   Int      @default(10) // ظرفیت جداگانه‌ی گروه (نفر)؛ صفر = بدون محدودیت
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]

  @@index([courseId])
}

// قالب اقساط دوره — تعداد و تاریخ سررسید هر قسط که مدیر در فرم دوره تعریف می‌کند
// (پیش‌فرض ۳ قسط؛ برای هر دوره قابل تغییر). هنگام ثبت‌نام اقساطی، طرح واقعی
// کاربر از همین قالب ساخته می‌شود: تعداد = تعداد ردیف‌ها و سررسیدها = همین تاریخ‌ها.
model CourseInstallment {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  index     Int // شماره‌ی قسط (۱ تا N)
  dueDate   DateTime // تاریخ سررسید این قسط
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// ویدئوهای آموزشی
model Video {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  url         String   @default("") // لینک پخش: یوتیوب/آپارات/وی‌میو، لینک مستقیم فایل (https) یا مسیر فایل آپلودشده (/uploads/videos/...)؛ خالی یعنی قفل برای اعضا
  thumbnail   String   @default("")
  duration    String   @default("") // متن آزاد مثل «۱۸:۴۲»
  views       Int      @default(0)
  level       String   @default("مقدماتی")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)

  // — لیست پخش (اختیاری) —
  playlist    Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  playlistId  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([playlistId])
}

// لیست‌های پخش ویدئو — شبیه لیست پخش یوتیوب
model Playlist {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  thumbnail   String   @default("") // تصویر کاور لیست پخش (آپلود یا آدرس)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  // مخاطب نمایش لیست پخش: guest = فقط مهمان‌ها، user = فقط کاربران لاگین‌کرده، both = هر دو
  visibility  String   @default("both") // guest | user | both
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos      Video[]
}

// فونت‌های نصب‌شده سایت — ۵ فونت پیش‌فرض + فونت‌های آپلودی مدیر
// cssText قواعد کامل @font-face است (با مسیرهای /fonts/... برای پیش‌فرض‌ها
// و /uploads/fonts/... برای فایل‌های آپلودی)؛ family مقدار font-family برای استایل درون‌خطی است.
model InstalledFont {
  id        String   @id @default(cuid())
  key       String   @unique // کلید یکتا برای ارجاع در SiteSettings (sloganFont و…)
  label     String // نام نمایشی فارسی
  family    String // مقدار font-family بدون fallback
  cssText   String   @default("") // قواعد @font-face؛ خالی برای وزیرمتن (next/font محلی)
  builtin   Boolean  @default(false) // فونت‌های پیش‌فرض غیرقابل حذف‌اند
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// لینک‌ها و دکمه‌های هدر و فوتر — قابل مدیریت از پنل مدیر
// section: header | footer · kind: internal | external
model NavLink {
  id        String   @id @default(cuid())
  section   String   @default("header") // هدر یا فوتر
  label     String
  url       String   @default("") // مقصد: مسیر/لنگر داخلی (مثل #courses یا /register) یا آدرس خارجی کامل
  kind      String   @default("internal") // internal | external
  target    String   @default("same") // same | blank — باز شدن در تب جدید
  isButton  Boolean  @default(false) // نمایش به‌شکل دکمه برجسته (فقط هدر)
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}

// ————————————————— نمونه سوالات —————————————————

// دسته‌بندی نمونه سوالات — در برگه‌ی اختصاصی سایت به‌شکل کارت مربعی
// (آیکون + عنوان + شمارنده‌ی تعداد نمونه سوال) رندر می‌شود.
model SampleQuestionCategory {
  id          String            @id @default(cuid())
  title       String
  description String            @default("")
  icon        String            @default("BookOpen") // کلید آیکون از رجیستری sample-question-icons
  sortOrder   Int               @default(0)
  published   Boolean           @default(true)
  items       SampleQuestion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([published])
}

// نمونه سوال — فایل تصویر / PDF / ویدئوی بارگذاری‌شده توسط مدیر.
// فایل در public/uploads/sample-questions ذخیره و در جدول گالری
// (UploadedFile با بخش sampleQuestions) ثبت می‌شود.
model SampleQuestion {
  id         String                  @id @default(cuid())
  title      String
  description String                 @default("")
  fileUrl    String                  @default("") // مسیر عمومی فایل (/uploads/sample-questions/…)
  ext        String                  @default("") // پسوند کوچک‌شده (pdf، png، mp4…)
  size       Int                     @default(0) // حجم بایت
  views      Int                     @default(0) // تعداد بازدید
  sortOrder  Int                     @default(0)
  published  Boolean                 @default(true)
  categoryId String?
  category   SampleQuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([categoryId])
  @@index([published])
}

// نظرات کاربران
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  course    String   @default("")
  text      String
  rating    Int      @default(5) // ۱ تا ۵
  theme     String   @default("teal") // کلید تم آواتار از رجیستری
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ثبت‌نام‌های دوره‌ها (پیش‌ثبت‌نام)
model Enrollment {
  id             String    @id @default(cuid())
  name           String
  firstName      String    @default("") // نام کاربر (از مرحله‌ی ثبت‌نام/حساب)
  lastName       String    @default("") // نام خانوادگی کاربر
  phone          String
  course         String
  message        String? // (کاربرد قدیمی — از فرم سایت حذف شده)
  status         String    @default("new") // new | contacted | enrolled | archived

  // — گروه انتخابی (برای دوره‌های حضوری دارای گروه) —
  group          CourseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId        String?
  groupTitle     String? // تصویر لحظه‌ای نام گروه

  // — پیوند به حساب کاربری تاییدشده —
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?

  // — معدل کارآموز در این دوره (۰ تا ۲۰) — مدیر از صفحه‌ی دوره ثبت می‌کند؛
  // null یعنی هنوز نمره‌ای ثبت نشده است.
  grade          Float?

  // — کد تخفیف اعمال‌شده (در صورت استفاده) —
  discountCode   String? // متن کد تخفیف ثبت‌شده در فرم
  discountAmount Int? // مبلغ تخفیف اعمال‌شده (تومان)

  // — اطلاعات پرداخت پیش‌ثبت‌نام —
  paymentMethod  String? // cash | installment
  paymentAmount  Int? // مبلغ قابل پرداخت (تومان)
  paymentStatus  String    @default("pending") // pending | paid | failed
  paymentGateway String? // zarinpal | payping | test
  paymentRefId   String? // کد پیگیری درگاه (authority / refId)
  // — کد یکتای «تلاش پرداخت» (نسخه‌ی ۳ چرخه‌ی پرداخت): در آغاز هر تلاش
  // تولید و روی ثبت‌نام ذخیره می‌شود و کال‌بک درگاه فقط برای همان تلاش
  // دقیق (تطبیق کد + مبلغ) پرداخت را ثبت می‌کند. برای پی‌پینگ همان مقدار
  // به‌عنوان clientRefId به درگاه ارسال می‌شود؛ ستون اختیاری است تا
  // پرداخت‌های قدیمی (نسخه‌های پیشین) بدون کد هم معتبر بمانند.
  paymentAttemptCode String?
  paymentCardPan String? // شماره کارت ماسک‌شده
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  // — اقساط (برای ثبت‌نام‌های پرداخت اقساطی) —
  installments   Installment[]

  // — تلاش‌های پرداخت آنلاینِ اقساط از پنل کاربر —
  installmentPayments InstallmentPayment[]

  // — حضور و غیاب این ثبت‌نام در جلسات دوره —
  attendanceRecords AttendanceRecord[]
}

// جلسه‌ی حضور و غیاب یک دوره — با فعال‌سازی چک‌باکس سر ستون ساخته می‌شود؛
// «فعال» یعنی حضور و غیاب آن جلسه در جریان است (همه حاضر ثبت می‌شوند).
// heldAt تاریخ فعال‌سازی/برگزاری جلسه است که در انتهای ستون نشان داده می‌شود.
model AttendanceSession {
  id        String    @id @default(cuid())
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  index     Int // شماره‌ی جلسه (۱ تا N)
  active    Boolean   @default(false)
  heldAt    DateTime? // تاریخ فعال‌سازی جلسه — تاریخ انتهای ستون
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  records   AttendanceRecord[]

  @@unique([courseId, index])
  @@index([courseId])
}

// حضور و غیاب هر ثبت‌نام در یک جلسه — true = حاضر، false = غایب
model AttendanceRecord {
  id            String            @id @default(cuid())
  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  enrollment    Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId  String
  present       Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
}

// کاربران سایت — ثبت‌نام/ورود با تایید پیامکی شماره موبایل (مرحله‌ی اول فرم)
model User {
  id         String       @id @default(cuid())
  firstName  String
  lastName   String
  phone      String       @unique
  // کد ملی (اختیاری) — برای استعلام گواهی‌نامه‌ها در صفحه‌ی عمومی /certificate
  nationalId String?      @unique
  status     String       @default("active") // active | blocked — کاربر مسدود نمی‌تواند وارد پنل شود
  // — نقش حساب — چهار نقش در سیستم:
  //  • مدیر کل (AdminUser — جدول جدا) → دسترسی کامل پنل مدیر
  //  • استاد (teacher) → در پنل خود دوره/کلاس/استریم می‌سازد و مالی‌اش را می‌بیند
  //  • فراگیر → کاربر عادی که در حداقل یک دوره/کلاس عضو است (نقش محاسبه‌ای؛ ستون ندارد)
  //  • کاربر عادی → فقط ثبت‌نام سایت؛ بدون دوره/کلاس
  role       String       @default("student") // student | teacher
  note       String? // یادداشت مدیر درباره‌ی این کاربر
  // — شماره شبا (اختیاری) — استاد برای دریافت واریز درآمد خودش در بخش «مالی و
  // درآمد» پنلش ثبت می‌کند؛ مدیر هم از تب «درآمد استاد و شبا» در دیالوگ
  // «پرداختی‌ها و اقساط» می‌تواند آن را ویرایش کند.
  shabaNumber String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sessions   UserSession[]
  enrollments Enrollment[]
  examAttempts ExamAttempt[]
  certificates Certificate[]
  classMemberships ClassMembership[]
  streamParticipants StreamParticipant[]

  // — دارایی‌های استاد (فقط برای role="teacher" معنی دارد) —
  taughtCourses Course[]
  taughtClasses ClassRoom[]
  hostedStreams LiveStream[]
  // — آزمون‌های ساخته‌شده در پنل استاد («ساخت آزمون») —
  createdExams  Exam[]          @relation("TeacherExams")
  // — واریزهای درآمد استاد (ثبت دستی مدیر) —
  payouts    TeacherPayout[]
}

// ————————————————— واریز درآمد استاد —————————————————

// واریز دستی درآمد به استاد — مدیر از تب «درآمد استاد و شبا» در دیالوگ
// «پرداختی‌ها و اقساط» (روبدروی هر استاد در ماژول مدیریت کاربران) ثبت
// می‌کند: مبلغ + وضعیت (واریز‌شده / در انتظار واریز) + تاریخ و یادداشت.
// جمعِ واریزهای «paid» با درآمد کل استاد مقایسه می‌شود تا وضعیت تسویه/مانده
// به دست آید. حذف استاد → واریزهایش هم پاک می‌شود (Cascade).
model TeacherPayout {
  id        String    @id @default(cuid())
  teacherId String
  amount    Int // مبلغ واریز (تومان)
  status    String    @default("paid") // paid | pending
  note      String? // یادداشت مدیر (مثلاً شماره پیگیری واریز)
  paidAt    DateTime? // تاریخ واریز — پیش‌فرض زمان ثبت
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teacher   User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

// ————————————————— کلاس‌ها —————————————————

// کلاس آموزشی — از ماژول «کلاس‌ها» در پنل مدیر ساخته می‌شود. هر کلاس لینک
// دعوت یکتای خود را دارد (inviteSlug → /join/inviteSlug) و کاربران فقط با
// کلیک روی همان لینک و تکمیل فرم ثبت‌نام عضو کلاس می‌شوند. ثبت‌نام معمولی
// سایت بدون کلاس است؛ هر کاربر می‌تواند عضو چندین کلاس باشد (بدون سقف).
model ClassRoom {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  // شناسه‌ی یکتای لینک دعوت — قابل مشاهده/کپی و قابل تغییر از پنل مدیر
  inviteSlug  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ClassMembership[]
  // آزمون‌های تعریف‌شده فقط برای این کلاس (accessType = "class")
  exams  Exam[]
  // دعوت‌های کلاس‌های آنلاین (استریم) این کلاس
  streamInvitations StreamInvitation[]

  // — استاد مالک کلاس (اختیاری) — کلاس‌هایی که استاد از پنل خود ساخته است؛
  // null یعنی کلاسِ مدیر. حذف استاد، کلاس را نگه می‌دارد (SetNull).
  teacher   User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?

  @@index([teacherId])
}

// عضویت کاربر در کلاس — یک ردیف برای هر جفت (کاربر، کلاس)؛ حذف کاربر یا
// کلاس عضویت‌ها را هم حذف می‌کند. لیست کلاس‌های کاربر در پنل او نمایش داده
// نمی‌شود (فقط مدیر می‌بیند).
model ClassMembership {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  createdAt DateTime  @default(now())

  @@unique([userId, classId])
  @@index([classId])
}

// ————————————————— گواهینامه‌ها —————————————————

// گواهینامه‌ی پایان دوره — از ماژول «صدور گواهینامه» در پنل مدیر ساخته می‌شود:
// فایل گواهینامه (PDF یا تصویر) آپلود می‌شود و به یک کاربر و دوره‌ای که در آن
// شرکت کرده تخصیص می‌یابد؛ کاربر آن را در پنل خود می‌بیند و می‌تواند دانلود کند.
// courseId با حذف دوره null می‌شود اما courseTitle (تصویر لحظه‌ای) حفظ می‌گردد.
model Certificate {
  id          String   @id @default(cuid())
  code        String   @unique // کد رهگیری/اعتبارسنجی برای نمایش روی برگه
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId    String?
  courseTitle String   @default("") // تصویر لحظه‌ای عنوان دوره
  grade       Float? // معدل ثبت‌شده هنگام صدور (۰ تا ۱۰۰)
  note        String   @default("") // توضیح/عنوان اختیاری روی گواهینامه
  // فایل آپلودشده‌ی گواهینامه (PDF یا تصویر) — /uploads/certificates/...؛
  // خالی یعنی گواهینامه‌ی بدون فایل (نمایش برگه‌ی سیستمی قابل چاپ در پنل کاربر)
  fileUrl     String   @default("")
  issuedAt    DateTime @default(now()) // تاریخ صدور
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
}

// ————————————————— آزمون‌ها —————————————————

// آزمون — چهار نوع دسترسی:
//   course   : آزمون دوره — فقط اعضای همان دوره (ثبت‌نام‌شدگان آن) آن را می‌بینند
//   open     : آزمون آزاد — همه‌ی کاربران وارد‌شده آن را می‌بینند
//   password : آزمون رمزدار — با وارد کردن رمز توسط کاربر باز می‌شود
//   class    : آزمون کلاس — فقط اعضای همان کلاس آن را در پنل خود می‌بینند و می‌توانند
//              آن را باز کنند (سایر کاربران اصلاً آن را نمی‌بینند).
// بانک آزمون‌ها: هر آزمونِ اصلی (isBankCopy=false) یک‌بار به‌صورت خودکار در بانک
// ذخیره می‌شود؛ دکمه‌ی «برگزاری دوباره» نسخه‌ی تازه‌ای از همان سوالات برای همان
// کلاس یا کلاس دیگر می‌سازد (isBankCopy=true با پاسخ‌برگه‌های جدید).
model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  accessType      String   @default("open") // course | open | password | class
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String? // آزمون دوره — دوره‌ی وابسته
  // کلاس هدف آزمون کلاس — حذف کلاس از API مدیر آزمون‌های آن را آزاد+منتشرنشده می‌کند
  class           ClassRoom? @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId         String?
  password        String   @default("") // رمز آزمون رمزدار
  durationMinutes Int      @default(0) // مدت آزمون (دقیقه)؛ صفر = بدون محدودیت زمانی
  allowBack       Boolean  @default(true) // امکان بازگشت به سوالات قبلی هنگام آزمون (سوییچ مدیر)
  published       Boolean  @default(true) // منتشر شده = قابل مشاهده در پنل کاربر
  sortOrder       Int      @default(0) // ترتیب نمایش در پنل مدیر و پنل کاربر — با کشیدن و رها کردن تغییر می‌کند
  // بانک آزمون‌ها — true یعنی این ردیف یک «برگزاری دوباره» است (در بانک فهرست نمی‌شود)؛
  // bankOriginId شناسه‌ی آزمون اصلی بانک است (فقط برای شمارش برگزاری‌ها؛ بدون کلید خارجی).
  isBankCopy      Boolean  @default(false)
  bankOriginId    String?
  // — سازنده‌ی استاد (null = ساخته‌ی مدیر) —
  // پنل استاد بخش «ساخت آزمون» فقط آزمون‌های creatorId خودش را می‌بیند و
  // ویرایش می‌کند؛ حذف کاربر سازنده آزمون را رها می‌کند (SetNull) تا دسترس
  // آزمون در پنل کاربران سالم بماند.
  creator          User?    @relation("TeacherExams", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions       ExamQuestion[]
  attempts        ExamAttempt[]

  @@index([courseId])
  @@index([classId])
  @@index([isBankCopy])
  @@index([creatorId])
}

// سوال آزمون — هشت نوع پشتیبانی‌شده:
//   multiple_choice چهارگزینه‌ای · true_false دوگزینه‌ای (درست/نادرست) · fill_blank جای خالی
//   short_answer پاسخ کوتاه · essay تشریحی · matching وصل‌کردنی · ordering مرتب‌کردنی · table_fill پرکردن جدول
// options/answer رشته‌ی JSON با ساختار مخصوص هر نوع هستند (در src/lib/exam.ts قراردادشان آمده).
// تصویر و ویدئو (آپلود یا آدرس) برای همه‌ی انواع قابل‌الحاق است.
model ExamQuestion {
  id      String   @id @default(cuid())
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId  String
  type    String
  text    String   @default("")
  image   String   @default("") // تصویر سوال (آپلود یا آدرس)
  video   String   @default("") // ویدئو سوال (آپلود یا آدرس)
  points  Float    @default(1)
  options String   @default("{}") // JSON ساختار سوال (گزینه‌ها/جفت‌ها/جدول و…)
  answer  String   @default("{}") // JSON پاسخ صحیح یا پاسخ‌های مجاز
  order   Int      @default(0)

  @@index([examId])
}

// پاسخ کاربر به یک آزمون — هر بار شرکت یک ردیف؛ پاسخ‌ها JSON به ازای هر سوال است.
// سوالات عینی خودکار تصحیح می‌شوند (autoScore)؛ نمره‌ی کسب‌شده‌ی هر سوال
// در grades نگه داشته می‌شود و مدیر می‌تواند آن را ویرایش کند.
// نمره‌ی نهایی (score) خودکار = جمع نمره‌ی سوالات؛ scoreManual=true یعنی مدیر
// نمره‌ی نهایی را دستی تعیین کرده است.
model ExamAttempt {
  id          String    @id @default(cuid())
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  answers     String    @default("{}") // JSON پاسخ‌های کاربر
  grades      String    @default("{}") // JSON نمره‌ی کسب‌شده‌ی هر سوال (questionId → نمره) — قابل ویرایش توسط مدیر
  score       Float? // نمره‌ی نهایی — null تا تصحیح توسط مدیر
  scoreManual Boolean   @default(false) // true = نمره‌ی نهایی دستی؛ false = جمع خودکار نمره‌ی سوالات
  autoScore   Float     @default(0) // نمره‌ی خودکار از سوالات عینی
  totalPoints Float     @default(0) // جمع نمره‌ی کل سوالات
  hasEssay    Boolean   @default(false) // دارای سوال تشریحی در انتظار تصحیح
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([examId, userId])
  @@index([userId])
}

// نشست ورود کاربران سایت
model UserSession {
  id        String    @id @default(cuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime   @default(now())
  // آخرین باری که این نشست «دیده» شده (GET /api/user/session) —
  // ضربان حضور برای شمارش «کاربران آنلاین» در نمودارهای پنل مدیر
  lastSeenAt DateTime?
}

// اقساط پرداخت — برای ثبت‌نام‌هایی که روش پرداخت اقساطی را انتخاب کرده‌اند
// طرح اقساط هنگام ثبت‌نام اقساطی ساخته می‌شود و در پنل مدیر و پنل کاربر نمایش داده می‌شود
model Installment {
  id           String     @id @default(cuid())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  index        Int // شماره‌ی قسط (۱ تا N)
  amount       Int // مبلغ این قسط (تومان)
  dueDate      DateTime // سررسید پرداخت
  status       String     @default("pending") // pending | paid | overdue
  paidAt       DateTime?
  note         String? // یادداشت مدیر (مثلاً شماره پیگیری واریز)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([enrollmentId])
  @@index([status, dueDate])
}

// تلاش پرداخت آنلاینِ «یک یا چند قسط» از پنل کاربر — چرخه‌ی مستقل از پرداخت
// پیش‌ثبت‌نام: در آغاز پرداخت رکورد با «کد تلاش» ساخته می‌شود؛ کال‌بک درگاه
// فقط برای همان تلاشِ دقیق (تطبیق کد تلاش + مبلغ) اقساط را paid می‌کند.
// installmentIds = آرایه‌ی JSON شناسه‌ی اقساط تحت پوشش این تلاش.
model InstallmentPayment {
  id             String   @id @default(cuid())
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId   String
  installmentIds String   @default("[]") // JSON: ["id1", "id2", …]
  amount         Int // جمع مبالغ اقساط این تلاش (تومان)
  status         String   @default("pending") // pending | paid | failed
  gateway        String   @default("") // payping | zarinpal | test
  refId          String? // کد پرداخت درگاه (paymentCode / authority / کد آزمایشی)
  attemptCode    String   @unique // کد یکتای تلاش — clientRefId پی‌پینگ
  cardPan        String? // شماره کارت ماسک‌شده
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enrollmentId])
  @@index([status])
  @@index([attemptCode])
}

// تنظیمات پنل پیامکی — ملی پیامک (رکورد یگانه با id = "main")
// دو روش اتصال: وب‌سرویس REST (rest.payamak-panel.com) با نام کاربری + رمز عبور/کلید API،
// و کنسول ملی پیامک (console.melipayamak.com) با توکن کنسول (داخل مسیر URL)
model SmsSettings {
  id            String   @id @default("main")
  provider      String   @default("none") // none | rest | console
  // — وب‌سرویس REST —
  username      String   @default("") // نام کاربری پنل ملی پیامک (الزامی)
  password      String   @default("") // رمز عبور پنل (یا خالی در صورت استفاده از کلید API)
  apiKey        String   @default("") // کلید API وب‌سرویس — جایگزین رمز عبور (داخل بدنه‌ی JSON ارسال می‌شود)
  // — کنسول ملی پیامک —
  consoleApiKey String   @default("") // توکن کنسول (حساب کاربری ← توکن) — داخل مسیر URL ارسال می‌شود
  // — مشترک —
  fromNumber    String   @default("") // شماره‌ی خط فرستنده (مثل 500040...)
  otpBodyId     String   @default("") // شناسه‌ی پترن OTP برای ارسال خدماتی (اختیاری؛ خالی = ارسال ساده/SendOTP)
  signature     String   @default("") // امضای انتهای همه‌ی پیامک‌ها (اختیاری)
  updatedAt     DateTime @updatedAt
}

// گزارش ارسال پیامک‌ها — هر ارسال (دستی/OTP/تستی/سیستمی) ثبت می‌شود
model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  text      String
  kind      String   @default("manual") // manual | otp | test | system
  provider  String   @default("none") // none | rest | console
  status    String   @default("pending") // sent | failed | pending
  recId     String   @default("") // شناسه‌ی رسالت ملی پیامک (Value)
  response  String   @default("") // پاسخ خام سرویس (کوتاه‌شده برای عیب‌یابی)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([phone])
}

// کدهای یک‌بارمصرف پیامکی (تایید شماره موبایل)
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String // کد ۶ رقمی هش‌شده
  // هدف‌مندیِ کد — کدِ صادرشده برای یک هدف فقط در همان هدف مصرف می‌شود
  // (user_auth: ورود/ثبت‌نام کاربر سایت · panel_login: ورود پنل کاربر ·
  //  admin_2fa: مرحله‌ی دوم ورود مدیر · admin_phone: تایید شماره‌ی جدید مدیر)
  purpose    String    @default("general")
  attempts   Int       @default(0) // حداکثر ۵ تلاش برای هر کد
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([phone, purpose, createdAt])
}

// شمارنده‌ی پایدارِ محدودیت نرخ درخواست‌ها (حداکثر N تلاش در پنجره‌ی زمانی) —
// «پایدار» یعنی پس از ری‌استارت هم باقی می‌ماند (همان SQLite موجود؛ بدون
// وابستگی زیرساختی تازه مثل Redis). کلید = دامنه + حساب/شماره/IP.
model RateLimitEntry {
  key         String   @id
  windowStart DateTime // شروع پنجره‌ی شمارش
  count       Int      @default(0)

  @@index([windowStart])
}

// ثبت‌نام نیمه‌کاره — فرم یکپارچه‌ی «ورود/ثبت‌نام»: پس از تایید موفق شماره‌ی
// موبایلِ ثبت‌نشده (کد پیامکی مصرف‌شده) و پیش از دریافت مشخصات کاربر ساخته
// می‌شود؛ توکن یک‌بارمصرفِ کوتاه‌مدت اجازه‌ی ساخت حساب بدون درخواست دوباره‌ی
// کد را می‌دهد. با ثبت مشخصات یا انقضا حذف می‌شود.
model PendingRegistration {
  id        String   @id @default(cuid())
  phone     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ————————————————— آمار سایت (نمودارهای پنل مدیر) —————————————————

// شمارنده‌های روزانه — هر روز حداکثر یک ردیف؛ کلید روز «YYYY-MM-DD» بر
// اساس تقویم/زمان‌بندی Tehran (مخاطب سایت) ساخته می‌شود.
model StatsDaily {
  day            String @id // "2026-11-17"
  visits         Int    @default(0) // تعداد بازدید صفحه (هر بار لود صفحه‌ی سایت)
  uniqueVisitors Int    @default(0) // بازدیدکننده‌ی یکتای آن روز (کوکی بازدیدکننده)
  signups        Int    @default(0) // ثبت‌نام موفق (ساخت حساب جدید)
  logins         Int    @default(0) // ورود موفق حساب‌های موجود
}

// «بازدیدکننده‌ی یکتا در روز» — یک ردیف به ازای هر (روز، بازدیدکننده)؛
// درج تکراری با unique رد می‌شود (P2002) یعنی قبلاً شمرده شده است.
model VisitVisitorDay {
  id        String   @id @default(cuid())
  day       String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([day, visitorId])
  @@index([day])
}

// ضربان حضور کاربران آنلاین — نشستِ دیده‌شده (حداکثر هر ۶۰ ثانیه یک ضربان)
// یک ردیف می‌نویسد؛ «آنلاین» = ضربان در ۵ دقیقه‌ی اخیر. ردیف‌های قدیمی‌تر
// از ۴۸ ساعت در حین گزارش‌گیری هرس می‌شوند.
model PresencePulse {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())

  @@index([at])
}

// ————————————————— گالری فایل‌ها —————————————————

// متادیتای فایل‌های آپلودی سایت — هر آپلود (تصویر/ویدئو/فونت/گواهینامه)
// یک ردیف ثبت می‌کند: چه کسی، در کدام بخش و چه فایلی بارگذاری کرده است.
// ماژول «گالری» در پنل مدیر همین جدول را همراه با اسکن دیسک
// (public/uploads) نمایش می‌دهد؛ فایل‌های قدیمی (پیش از این جدول) هنگام
// همگام‌سازی وارد می‌شوند و بخششان از محل استفاده در دیتابیس استنباط می‌شود.
model UploadedFile {
  id           String   @id @default(cuid())
  url          String   @unique // مسیر عمومی فایل (/uploads/... یا /uploads/videos/...)
  name         String // نام فایل روی دیسک (نام یکتای تصادفی)
  originalName String   @default("") // نام اصلی فایل هنگام آپلود
  ext          String   @default("") // پسوند کوچک‌شده (png، mp4، woff2، pdf…)
  mime         String   @default("") // نوع MIME اعلام‌شده هنگام آپلود
  size         Int      @default(0) // حجم فایل (بایت)
  section      String   @default("other") // بخش سایت: courses | videos | exams | certificates | fonts | settings | chat | other
  uploader     String   @default("") // نام کاربری آپلودکننده (مدیر)
  createdAt    DateTime @default(now()) // زمان آپلود / شناسایی فایل
  updatedAt    DateTime @updatedAt

  @@index([section])
  @@index([ext])
  @@index([createdAt])
}

// کدهای تخفیف پیش‌ثبت‌نام — قابل تعریف برای پرداخت نقدی/اقساطی (یا هر دو)
// valueType: percent (درصد ۱ تا ۱۰۰) یا amount (مبلغ ثابت تومان)
// paymentType: cash | installment | both
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique // کد یکتا (به‌صورت حروف بزرگ ذخیره می‌شود)
  paymentType String    @default("both") // cash | installment | both
  valueType   String    @default("percent") // percent | amount
  value       Int       @default(0) // درصد یا مبلغ تخفیف (تومان)
  maxUses     Int       @default(0) // حداکثر استفاده (۰ = نامحدود)
  usedCount   Int       @default(0) // تعداد استفاده تا کنون
  expiresAt   DateTime? // تاریخ انقضا (null = بی‌نهایت)
  active      Boolean   @default(true)
  note        String? // توضیح داخلی مدیر
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

// تنظیمات درگاه پرداخت (رکورد یگانه با id = "main")
// توجه: شهریه نقدی/اقساطی هر دوره در همان رکورد Course تعریف می‌شود.
model PaymentSettings {
  id                 String   @id @default("main")
  gateway            String   @default("none") // none | zarinpal | payping | test
  zarinpalMerchantId String   @default("") // شناسه پذیرنده زرین‌پال
  paypingApiKey      String   @default("") // توکن API پی‌پینگ
  installmentCount   Int      @default(3) // تعداد اقساط پیش‌فرض (وقتی دوره قالب اختصاصی ندارد)
  updatedAt          DateTime @updatedAt
}

// مدیران پنل
model AdminUser {
  id              String         @id @default(cuid())
  username        String         @unique
  passwordHash    String
  // — تایید دومرحله‌ای پیامکی ورود مدیر —
  // شماره موبایل مدیر که کد تایید به آن ارسال می‌شود
  phone           String         @default("")
  // فعال/غیرفعال بودن مرحله‌ی دوم (کد پیامکی) — پیش‌فرض غیرفعال؛
  // ورود فقط با نام کاربری و رمز عبور ممکن است.
  twoFactorEnabled Boolean       @default(false)
  createdAt        DateTime       @default(now())
  sessions         AdminSession[]
}

// نشست‌های ورود مدیر
model AdminSession {
  id        String     @id @default(cuid())
  token     String     @unique
  admin     AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  expiresAt DateTime
  createdAt DateTime   @default(now())
}

// تنظیمات چت‌بات پشتیبانی سایت (رکورد یگانه با id = "main")
model ChatSettings {
  id             String   @id @default("main")
  botName        String   @default("پشتیبان آوید")
  botTitle       String   @default("پشتیبانی آکادمی آوید")
  botAvatar      String   @default("/images/chat/bot-avatar.png")
  // نحوه‌ی نمایش «تصویر پروفایل چت‌بات» روی دکمه‌ی شناور پایین صفحات سایت:
  //   circle = حالت دایره‌ای (رفتار کنونی): برش مربع ۱:۱ داخل قاب دایره با حاشیه/سایه
  //   custom = حالت دلخواه: تصویر آزاد — بدون قاب/استروک/حاشیه/سایه و بدون برش ۱:۱؛
  //            ارتفاع حداکثر اندازه‌ی پروفایل و عرضِ اصل تصویر حفظ می‌شود؛
  //            پس‌زمینه‌ی شفاف همان‌گونه شفاف می‌ماند (رنگ پس‌زمینه اضافه نمی‌شود)
  botAvatarMode   String   @default("circle") // circle | custom
  welcomeMessage String   @default("سلام 👋 به آکادمی آوید خوش آمدید!\nمن پشتیبان آنلاین آوید هستم. اگر درباره‌ی دوره‌ها، ثبت‌نام یا پرداخت سوالی دارید همین‌جا بنویسید؛ پیام شما مستقیماً به تیم پشتیبانی می‌رسد و سریع پاسخ می‌گیرد.")
  autoOpen       Boolean  @default(true) // نمایش خودکار حباب خوش‌آمدگویی هنگام ورود کاربر به سایت (هر IP یک بار در شبانه‌روز)
  // ثانیه‌های نمایش حباب خوش‌آمدگویی تا مخفی‌شدن خودکارِ انیمیت‌دار؛
  // ۰ = بدون مخفی‌شدن خودکار (حباب می‌ماند تا کاربر ببندد) — قابل ویرایش در ماژول «مدیریت چت» پنل مدیر
  welcomeAutoHideSeconds Int     @default(7)
  isActive       Boolean  @default(true) // فعال/غیرفعال بودن چت برای بازدیدکنندگان
  updatedAt      DateTime @updatedAt
}

// نمایش حباب پیام خوش‌آمدگویی چت —
// برای هر IP حداکثر یک بار در هر شبانه‌روز (مرز روز به وقت تهران) در کل سایت
model ChatWelcomeLog {
  ip      String   @id
  shownAt DateTime @default(now())
}

// گفتگوی هر بازدیدکننده سایت با پشتیبانی (با توکن کوکی مرورگر شناسایی می‌شود)
model ChatConversation {
  id                 String        @id @default(cuid())
  visitorToken       String        @unique
  displayName        String        @default("") // نام نمایشی بازدیدکننده (اختیاری)
  lastMessageAt      DateTime      @default(now())
  lastMessagePreview String        @default("") // ۱۲۰ کاراکتر آخر پیام برای لیست مدیر
  unreadForAdmin     Int           @default(0)
  unreadForVisitor   Int           @default(0)
  createdAt          DateTime      @default(now())
  messages           ChatMessage[]
}

// پیام‌های گفتگو (بازدیدکننده / مدیر / ربات)
model ChatMessage {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         String // visitor | admin | bot
  senderName     String           @default("")
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// ————————————————— کلاس آنلاین (استریم) —————————————————

// جلسه‌ی کلاس آنلاین — از ماژول «مدیریت استریم» در پنل مدیر ساخته می‌شود.
// مدیر با انتخاب یک یا چند دوره/کلاس، کاربران همان دوره/کلاس را به کلاس دعوت
// می‌کند؛ دعوت در پنل کاربر (زیر باکس مشخصات) فقط برای همان کاربران ظاهر
// می‌شود و در غیاب دعوتِ فعال کاملاً مخفی است. وضعیت‌ها:
//   scheduled — ایجادشده، پخش شروع نشده (چت فعال است)
//   live      — مدیر در حال پخش صدا/تصویر است
//   ended     — جلسه پایان یافته (ورود جدید رد می‌شود)
model LiveStream {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("scheduled") // scheduled | live | ended
  // — شناسه‌ی یکتای «لینک دعوت» کلاس آنلاین — لینکِ اشتراکی استاد با دانشجوها
  // (inviteSlug → /stream/inviteSlug). لینک خودش دعوت است: هر کاربر وارد‌شده‌ی
  // دارنده‌ی لینک می‌تواند وارد شود. null یعنی استریم بدون لینک مستقیم (اداری).
  inviteSlug  String?  @unique
  startedAt   DateTime? // لحظه‌ی شروع پخش (مدیر یا استادِ مالک)
  endedAt     DateTime? // لحظه‌ی پایان جلسه
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // — استاد مالک جلسه (اختیاری) — جلساتی که استاد از پنل خود ساخته است؛
  // null یعنی جلسه‌ی مدیر. مالک، نقش host اتاق را می‌گیرد. حذف استاد → SetNull.
  host        User?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  hostId      String?

  invitations StreamInvitation[]
  participants StreamParticipant[]

  @@index([hostId])
}

// دعوت کاربران یک دوره یا کلاس به کلاس آنلاین — هر ردیف یک هدف دعوت است.
// کاربرانِ مدنظر در لحظه‌ی ورود از روی عضویت‌های زنده تعیین می‌شوند:
//   courseId   → کاربرانی که ثبت‌نام (Enrollment) فعالِ همان دوره را دارند
//   classId    → اعضای همان کلاس (ClassMembership)
// عنوان دوره به‌صورت تصویر لحظه‌ای (courseTitle) ذخیره می‌شود تا با تغییر/حذف
// دوره، سند گزارش خوانا بماند. حذف دوره/کلاس فقط دعوت را می‌بُرد؛ استریم می‌ماند.
model StreamInvitation {
  id          String     @id @default(cuid())
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId    String
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String?
  courseTitle String     @default("") // تصویر لحظه‌ای عنوان دوره
  classRoom   ClassRoom? @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String?
  createdAt   DateTime   @default(now())

  @@index([streamId])
}

// حضور هر کاربر در یک کلاس آنلاین — یک ردیف برای هر (کلاس، کاربر)؛
// ورود مجدد پس از خروج دوباره همین ردیف را به‌روز می‌کند (joinedAt جدید).
// kicked=true یعنی مدیر او را از کلاس اخراج کرده — تا وقتی کلاس زنده است
// ورود دوباره رد می‌شود. این جدول منبع خروجی اکسل «شرکت‌کنندگان استریم» است.
model StreamParticipant {
  id        String     @id @default(cuid())
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime   @default(now())
  leftAt    DateTime?
  kicked    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([streamId, userId])
  @@index([streamId])
}

// مدیریت سکشن‌های صفحه‌ی اول سایت — نمایش/مخفی‌سازی هر سکشن به تفکیک پلتفرم:
//   موبایل (< 768px) · تبلت (768–1023px) · دسکتاپ (≥ 1024px)
// جدول فقط « override های مدیر» را نگه می‌دارد (مانند SiteText):
// نبودِ رکورد یعنی سکشن در هر سه پلتفرم نمایان است.
model HomepageSection {
  key       String   @id // hero | courses | actionCards | counters | register | videos | samples | testimonials
  mobile    Boolean  @default(true)
  tablet    Boolean  @default(true)
  desktop   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// «انیمیشن‌های هیرو» — زیرمجموعه‌ی سکشن هیرو در مدیریت صفحه‌ی اول:
// روشن/خاموشِ فقط صحنه‌ی «اتم ↔ اثر انگشت» به تفکیک پلتفرم (موبایل < 768px · تبلت 768–1023px · دسکتاپ ≥ 1024px).
// نمادهای شناور (π، ∑، ∞، </>)، آیکون‌ها و متن‌ها تابع این سوئیچ‌ها نیستند و همیشه نمایان‌اند؛
// مخفی‌سازی کل هیرو از سوئیچ‌های خودِ سکشن هیرو انجام می‌شود.
// جدول فقط overrideهای مدیر را نگه می‌دارد؛ نبودِ رکورد یعنی انیمیشن در هر سه پلتفرم روشن است.
model HeroAnimation {
  key       String   @id // scene (اتم ↔ اثر انگشت) — تنها انیمیشن قابل کنترل
  mobile    Boolean  @default(true)
  tablet    Boolean  @default(true)
  desktop   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
